### Register a student
POST http://localhost:8080/api/auth/student/register
Content-Type: application/json

{
  "studentNumber": "S12345678",
  "firstName": "Kelvin",
  "lastName": "Mudzingwa",
  "email": "test@mandela.ac.za",
  "phone": "0821234567",
  "password": "test123"
}

### Login as that student
POST http://localhost:8080/api/auth/student/login
Content-Type: application/json

{
  "email": "test@mandela.ac.za",
  "password": "test123"
}

> {%
    client.global.set("student_token", response.body.token);
%}

### Get trips as a student
GET http://localhost:8080/api/trips
Authorization: Bearer {{student_token}}

### Get Scheduled trips as a student
GET http://localhost:8080/api/trips/status/SCHEDULED
Authorization: Bearer {{student_token}}

### Get Completed trips as a student
GET http://localhost:8080/api/trips/status/COMPLETED
Authorization: Bearer {{student_token}}

### Get Cancelled trips as a student
GET http://localhost:8080/api/trips/status/CANCELLED
Authorization: Bearer {{student_token}}

### Register a driver
POST http://localhost:8080/api/auth/driver/register
Content-Type: application/json

{
  "firstName": "Sam",
  "lastName": "Driver",
  "email": "sam.driver@example.com",
  "phone": "0839876543",
  "password": "driverpass",
  "role": "STUDENT_DRIVER"
}

### Login as that driver
POST http://localhost:8080/api/auth/driver/login
Content-Type: application/json

{
  "email": "sam.driver@example.com",
  "password": "driverpass"
}

> {%
    client.global.set("driver_token", response.body.token);
%}

### Get my vehicles
GET http://localhost:8080/api/vehicles/my
Authorization: Bearer {{driver_token}}

### Get all vehicles
GET http://localhost:8080/api/vehicles
Authorization: Bearer {{student_token}}

### Register a Vehicle for the Driver
POST http://localhost:8080/api/vehicles
Content-Type: application/json
Authorization: Bearer {{driver_token}}

{
  "registrationNumber": "CB123456",
  "model": "Toyota Corolla",
  "vehicleYear": 2022,
  "colour": "White",
  "capacity": 4
}

### Create a Trip with Manual Coordinates
POST http://localhost:8080/api/trips
Content-Type: application/json
Authorization: Bearer {{driver_token}}

{
  "tripType": "Carpool",
  "departureStop": "4GR72J96+C4 Walmer, Gqeberha",
  "departureLat": -33.9814,
  "departureLng": 25.6103,
  "destinationStop": "4GR72M29+CX Summerstrand, Gqeberha",
  "destinationLat": -33.9989,
  "destinationLng": 25.6699,
  "departureTime": "2026-07-01T14:00:00",
  "availableSeats": 2,
  "price": 30.00
}

### Create a Trip (Automatic Geocoding - No coordinates provided)
POST http://localhost:8080/api/trips
Content-Type: application/json
Authorization: Bearer {{driver_token}}

{
  "tripType": "CarPool",
  "departureStop": "Bird Street, Gqeberha",
  "departureLat": -33.9581,
  "departureLng": 25.6011,
  "destinationStop": "Summerstrand, Gqeberha",
  "destinationLat": -33.9997,
  "destinationLng": 25.6698,
  "departureTime": "2026-07-01T14:00:00",
  "availableSeats": 2,
  "price": 30.00
}

### Get specific trip details (Verify Coordinates)
GET http://localhost:8080/api/trips/1
Authorization: Bearer {{student_token}}

### Get all trips (Verify Coordinates)
GET http://localhost:8080/api/trips
Authorization: Bearer {{student_token}}

### Get trips by status
GET http://localhost:8080/api/trips/status/CONFIRMED
Authorization: Bearer {{student_token}}

### Search for a ride (Student search by address)
GET http://localhost:8080/api/trips/search?departure=Bird Street&destination=Summerstrand
Authorization: Bearer {{student_token}}

### Search for a ride (Example: 15 Killanery Road to South Campus NMU)
GET http://localhost:8080/api/trips/search?departure=15 Killanery Road&destination=south campus nmu
Authorization: Bearer {{student_token}}

### Search for a ride (Student search by coordinates)
GET http://localhost:8080/api/trips/search?depLat=-33.9581&depLng=25.6011&destLat=-33.9997&destLng=25.6698&radius=5.0
Authorization: Bearer {{student_token}}

